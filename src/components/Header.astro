---
import type { Locale } from '../i18n/index';
import { t, localizePath, otherLocale, LOCALES } from '../i18n/index';

interface Props {
  locale: Locale;
  currentPath: string;
  translationExists: boolean;
}

const { locale, currentPath, translationExists } = Astro.props;
const other = otherLocale(locale);
const otherLabel = LOCALES.find((l) => l.code === other)?.nativeLabel ?? other;
const home = locale === 'hi' ? '/hi/' : '/';
const blog = locale === 'hi' ? '/hi/blog/' : '/blog/';
const search = locale === 'hi' ? '/hi/search/' : '/search/';
const rss = locale === 'hi' ? '/hi/rss.xml' : '/rss.xml';
const otherPath = translationExists ? localizePath(currentPath, other) : other === 'hi' ? '/hi/' : '/';
const isCurrent = (href: string) =>
  currentPath === href ||
  currentPath === href.replace(/\/$/, '') ||
  (href !== home && currentPath.startsWith(href));
/* Desktop primary nav: text link with animated underline (transform
   only). Current page is underlined + coloured, never colour alone. */
const desktopLink = (href: string) =>
  `flex min-h-[44px] items-center px-1 text-[17px] transition-colors duration-150 ${
    isCurrent(href)
      ? 'text-brand underline decoration-2 underline-offset-8 dark:text-brand-dark'
      : 'text-stone-700 hover:text-brand dark:text-[#d0d6e0] dark:hover:text-brand-dark'
  }`;
const menuLabel = locale === 'hi' ? 'मेनू' : 'Menu';
const closeLabel = locale === 'hi' ? 'बंद करें' : 'Close';
const utilityClass = 'flex min-h-[44px] items-center text-[15px] text-stone-600 transition-colors duration-150 hover:text-brand dark:text-[#8a8f98] dark:hover:text-brand-dark';
---

<!-- Header v4 — cross-verified (Exa, NN/g + web.dev + Material):
     1. Utility above primary (NN menu guideline 2): language, theme
        and RSS live in a thin utility bar ABOVE the main bar, so they
        are never hidden behind the hamburger and never compete with
        primary nav. The utility bar scrolls away; only the main bar
        is sticky.
     2. Primary nav visible on desktop (NN guideline 1): Home + Blog
        are always shown on desktop. Hamburger is mobile-only, a
        necessary evil on small screens, not a desktop pattern.
     3. Sticky main bar is small + opaque (NN sticky guidelines 1-2):
        56px, solid paper (dark: elevated surface, Material elevation
        principle — header surface lighter than page bg in dark),
        NO backdrop-blur/translucency, so content underneath never
        bleeds through and distracts. Shadow appears after scrolling
        via IntersectionObserver, not a scroll listener.
     4. Search is a CTA, not a third nav link: desktop main bar has
        a blue Search pill on the right; mobile menu still lists
        Search, so no path is lost.
     5. Mobile menu is a full-screen modal (v9, not a dropdown):
        hidden with display:none until opened (so its links are
        never keyboard-focusable while closed), then faded + risen
        in with transform/opacity only, links staggered in. Focus
        is trapped inside, Escape closes, body scroll locks, focus
        returns to the hamburger button. Menu is click-activated,
        never hover.
     Every target >= 44px (NN: 1cm x 1cm minimum on touch). -->
<div class="border-b border-stone-200 bg-paper dark:border-[#23252a] dark:bg-paper-dark">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-1 sm:px-6">
    <p class="hidden min-h-[36px] items-center text-[15px] italic text-stone-500 dark:text-[#8a8f98] sm:flex">
      {locale === 'hi' ? 'भारत में टेस्ट किए गए AI टूल' : 'AI tools, tested in India'}
    </p>
    <nav aria-label={locale === 'hi' ? 'उपयोगिता नेविगेशन' : 'Utility navigation'} class="ms-auto flex items-center gap-4">
      <a href={rss} class={utilityClass}>RSS</a>
      <a
        href={otherPath}
        lang={other === 'hi' ? 'hi' : 'en-IN'}
        aria-label={`${t(locale, 'language')}: ${otherLabel}`}
        class={utilityClass}
      >
        <span class="sm:hidden">{other === 'hi' ? 'हिन्दी' : 'EN'}</span><span class="hidden sm:inline">{otherLabel}</span>
      </a>
      <button
        type="button"
        id="theme-toggle"
        aria-label={t(locale, 'themeDark')}
        aria-pressed="false"
        data-light-label={t(locale, 'themeLight')}
        data-dark-label={t(locale, 'themeDark')}
        data-light-short={locale === 'hi' ? 'लाइट' : 'Light'}
        data-dark-short={locale === 'hi' ? 'डार्क' : 'Dark'}
        class="flex min-h-[44px] items-center gap-1.5 text-[15px] text-stone-600 transition-colors duration-150 hover:text-brand dark:text-[#8a8f98] dark:hover:text-brand-dark"
      >
        <svg aria-hidden="true" class="theme-icon inline-block transition-transform duration-250" width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
        <span class="theme-label">{locale === 'hi' ? 'डार्क' : 'Dark'}</span>
      </button>
    </nav>
  </div>
</div>

<div id="header-sentinel" aria-hidden="true" class="h-px"></div>
<header id="site-header" class="sticky top-0 z-40 border-b border-stone-200 bg-paper transition-shadow duration-250 dark:border-[#23252a] dark:bg-surface-dark">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex min-h-[56px] items-center gap-3">
      <a href={home} class="flex min-h-[44px] shrink-0 items-center gap-2.5" aria-label="Dus AI Tool — home">
        <img src="/favicon.svg" alt="" aria-hidden="true" width="36" height="36" class="size-9 shrink-0 transition-transform duration-250 hover:rotate-[-6deg]" />
        <span class="font-display text-[22px] leading-none tracking-tight text-[#1a1a1a] dark:text-[#f7f8f8]">Dus AI Tool</span>
      </a>

      <nav aria-label={locale === 'hi' ? 'मुख्य नेविगेशन' : 'Primary navigation'} class="ms-6 hidden items-center gap-6 sm:flex">
        <a href={home} aria-current={isCurrent(home) ? 'page' : undefined} class={desktopLink(home)}><span class="link-underline">{t(locale, 'home')}</span></a>
        <a href={blog} aria-current={isCurrent(blog) ? 'page' : undefined} class={desktopLink(blog)}><span class="link-underline">{t(locale, 'blog')}</span></a>
      </nav>

      <div class="ms-auto flex items-center gap-2">
        <a href={search} aria-current={isCurrent(search) ? 'page' : undefined} class="hidden min-h-[44px] items-center rounded-full bg-brand px-4 text-[16px] text-white transition-transform duration-150 hover:-translate-y-0.5 dark:bg-brand-dark dark:text-[#08090a] sm:flex">
          {t(locale, 'search')}
        </a>
        <button
          type="button"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={menuLabel}
          data-menu-label={menuLabel}
          data-close-label={closeLabel}
          class="flex min-h-[44px] min-w-[44px] flex-col items-center justify-center gap-1.5 rounded-full border border-stone-300 px-3 dark:border-[#34343a] sm:hidden"
        >
          <span aria-hidden="true" class="menu-bar block h-[2px] w-5 bg-current transition-transform duration-250"></span>
          <span aria-hidden="true" class="menu-bar block h-[2px] w-5 bg-current transition-transform duration-250"></span>
          <span aria-hidden="true" class="menu-bar block h-[2px] w-5 bg-current transition-transform duration-250"></span>
          <span class="sr-only menu-label">{menuLabel}</span>
        </button>
      </div>
    </div>

  </div>
</header>

<!-- Full-screen mobile menu (v9): a real modal dialog, not a dropdown.
     Hidden with display:none until opened (so its links are never
     keyboard-focusable while closed), then faded + risen in with
     transform/opacity only, links staggered. Focus is trapped inside
     while open, Escape closes, body scroll is locked, focus returns
     to the hamburger button on close. -->
<div
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label={locale === 'hi' ? 'मोबाइल नेविगेशन' : 'Mobile navigation'}
  data-open="false"
  class="mobile-menu fixed inset-0 z-50 hidden flex-col bg-paper dark:bg-surface-dark sm:hidden"
>
  <div class="mx-auto flex min-h-[56px] w-full max-w-6xl items-center justify-between gap-3 px-4">
    <span class="flex items-center gap-2.5">
      <img src="/favicon.svg" alt="" aria-hidden="true" width="36" height="36" class="size-9 shrink-0" />
      <span class="font-display text-[22px] leading-none tracking-tight text-[#1a1a1a] dark:text-[#f7f8f8]">Dus AI Tool</span>
    </span>
    <button
      type="button"
      id="menu-close"
      aria-label={closeLabel}
      class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-stone-300 dark:border-[#34343a]"
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav aria-label={locale === 'hi' ? 'मुख्य नेविगेशन' : 'Primary navigation'} class="mx-auto w-full max-w-6xl flex-1 px-4 pt-6">
    <a href={home} aria-current={isCurrent(home) ? 'page' : undefined} class="menu-link flex min-h-[64px] items-center border-b border-stone-200 font-display text-[28px] dark:border-[#23252a]">{t(locale, 'home')}</a>
    <a href={blog} aria-current={isCurrent(blog) ? 'page' : undefined} class="menu-link flex min-h-[64px] items-center border-b border-stone-200 font-display text-[28px] dark:border-[#23252a]">{t(locale, 'blog')}</a>
    <a href={search} aria-current={isCurrent(search) ? 'page' : undefined} class="menu-link flex min-h-[64px] items-center border-b border-stone-200 font-display text-[28px] dark:border-[#23252a]">{t(locale, 'search')}</a>
  </nav>
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-6 px-4 pb-8">
    <a href={otherPath} lang={other === 'hi' ? 'hi' : 'en-IN'} class="flex min-h-[44px] items-center text-[16px] text-stone-600 dark:text-[#8a8f98]">{t(locale, 'language')}: {otherLabel}</a>
    <a href={rss} class="flex min-h-[44px] items-center text-[16px] text-stone-600 dark:text-[#8a8f98]">RSS</a>
    <p class="w-full text-[15px] italic text-stone-500 dark:text-[#8a8f98]">{locale === 'hi' ? 'भारत में टेस्ट किए गए AI टूल' : 'AI tools, tested in India'}</p>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const sentinel = document.getElementById('header-sentinel');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('header-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }

  const btn = document.getElementById('theme-toggle');
  const labelEl = btn?.querySelector('.theme-label');
  const iconEl = btn?.querySelector('.theme-icon');
  const updateTheme = (isDark) => {
    if (labelEl) labelEl.textContent = isDark ? (btn?.dataset.lightShort ?? 'Light') : (btn?.dataset.darkShort ?? 'Dark');
    btn?.setAttribute('aria-pressed', String(isDark));
    btn?.setAttribute('aria-label', isDark ? btn?.dataset.lightLabel ?? '' : btn?.dataset.darkLabel ?? '');
    if (iconEl) iconEl.style.transform = isDark ? 'rotate(180deg)' : 'rotate(0deg)';
  };
  updateTheme(document.documentElement.classList.contains('dark'));
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('dusaitool-theme', isDark ? 'dark' : 'light');
    } catch {
      /* private mode: theme just lasts for this session */
    }
    updateTheme(isDark);
  });

  const menuBtn = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const menuCloseBtn = document.getElementById('menu-close');
  const menuLabelEl = menuBtn?.querySelector('.menu-label');
  const bars = menuBtn?.querySelectorAll('.menu-bar');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let previousOverflow = '';
  let menuCloseTimer = null;
  const focusableInMenu = () => Array.from(mobileNav?.querySelectorAll('a[href], button:not([disabled])') ?? []).filter((el) => el.offsetParent !== null || el === document.activeElement);
  const setMenuOpen = (open) => {
    if (!mobileNav || !menuBtn) return;
    if (menuCloseTimer) { clearTimeout(menuCloseTimer); menuCloseTimer = null; }
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? menuBtn.dataset.closeLabel ?? 'Close' : menuBtn.dataset.menuLabel ?? 'Menu');
    if (menuLabelEl) menuLabelEl.textContent = open ? menuBtn.dataset.closeLabel ?? 'Close' : menuBtn.dataset.menuLabel ?? 'Menu';
    if (bars && bars.length === 3) {
      bars[0].style.transform = open ? 'translateY(8px) rotate(45deg)' : '';
      bars[1].style.opacity = open ? '0' : '1';
      bars[2].style.transform = open ? 'translateY(-8px) rotate(-45deg)' : '';
    }
    if (open) {
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      mobileNav.classList.remove('hidden');
      mobileNav.classList.add('flex');
      requestAnimationFrame(() => {
        mobileNav.setAttribute('data-open', 'true');
        const first = focusableInMenu()[0];
        first?.focus();
      });
    } else {
      mobileNav.setAttribute('data-open', 'false');
      const finishClose = () => {
        mobileNav.classList.add('hidden');
        mobileNav.classList.remove('flex');
        document.body.style.overflow = previousOverflow;
        menuBtn.focus();
      };
      if (reducedMotion) {
        finishClose();
      } else {
        menuCloseTimer = setTimeout(finishClose, 300);
      }
    }
  };
  menuBtn?.addEventListener('click', () => {
    setMenuOpen(mobileNav?.getAttribute('data-open') !== 'true');
  });
  menuCloseBtn?.addEventListener('click', () => setMenuOpen(false));
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  mobileNav?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
      return;
    }
    if (event.key !== 'Tab') return;
    const focusable = focusableInMenu();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
