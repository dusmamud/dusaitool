---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/noto-serif-devanagari/400.css';
import '@fontsource/noto-serif-devanagari/700.css';
/* Preload URLs for the critical font files (Vite ?url gives the same
   hashed asset the @font-face CSS references, so no double download).
   Only the exact subset file the page needs is preloaded. */
import instrumentLatin400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import notoDevanagari400 from '@fontsource/noto-serif-devanagari/files/noto-serif-devanagari-devanagari-400-normal.woff2?url';
import notoDevanagari700 from '@fontsource/noto-serif-devanagari/files/noto-serif-devanagari-devanagari-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonical: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  image?: string;
  currentPath: string;
  translationExists?: boolean;
}

const {
  title, description, locale, canonical, type = 'website',
  publishedTime, updatedTime, image, currentPath, translationExists = false,
} = Astro.props;
const htmlLang = locale === 'hi' ? 'hi' : 'en-IN';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf8f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08090a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fonts are self-hosted woff2 (Fontsource, same origin, no Google
         Fonts). Best practice, cross-verified with Exa (web.dev):
         preload ONLY the above-fold fonts, with crossorigin even for
         self-hosted files (fonts are CORS resources, without it the
         preload is wasted and the file downloads twice). Preload
         ignores unicode-range, so preload the exact subset file the
         page needs: en pages need Instrument latin 400 (hero, nav,
         body; bold is synthesised from this file), hi pages need
         Noto Devanagari 400 (body) + 700 (bold headings/nav).
         Italic and latin/latin-ext subsets load via CSS when used. -->
    {locale === 'hi' ? (
      <>
        <link rel="preload" as="font" type="font/woff2" crossorigin href={notoDevanagari400} />
        <link rel="preload" as="font" type="font/woff2" crossorigin href={notoDevanagari700} />
      </>
    ) : (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={instrumentLatin400} />
    )}
    <!-- Theme before paint: stored choice wins, otherwise the OS choice.
         This prevents a flash of light theme for dark-mode readers. -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('dusaitool-theme');
        const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      } catch {
        /* ignore: private mode */
      }
    </script>
    <SEO
      title={title}
      description={description}
      locale={locale}
      canonical={canonical}
      type={type}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      image={image}
    />
    <link rel="alternate" type="application/rss+xml" title="Dus AI Tool RSS" href={locale === 'hi' ? '/hi/rss.xml' : '/rss.xml'} />
  </head>
  <body class="bg-paper font-sans text-ink antialiased dark:bg-paper-dark dark:text-text-dark-2" id="top">
    <a href="#main-content" class="skip-link">{t(locale, 'skip')}</a>
    <Header locale={locale} currentPath={currentPath} translationExists={translationExists} />
    <main id="main-content" tabindex="-1" class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
