---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/noto-serif-devanagari/400.css';
import '@fontsource/noto-serif-devanagari/700.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonical: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  currentPath: string;
  translationExists?: boolean;
}

const {
  title, description, locale, canonical, type = 'website',
  publishedTime, updatedTime, currentPath, translationExists = false,
} = Astro.props;
const htmlLang = locale === 'hi' ? 'hi' : 'en-IN';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf8f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08090a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Theme before paint: stored choice wins, otherwise the OS choice.
         This prevents a flash of light theme for dark-mode readers. -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('dusaitool-theme');
        const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      } catch {
        /* ignore: private mode */
      }
    </script>
    <SEO
      title={title}
      description={description}
      locale={locale}
      canonical={canonical}
      type={type}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
    />
    <link rel="alternate" type="application/rss+xml" title="Dus AI Tool RSS" href={locale === 'hi' ? '/hi/rss.xml' : '/rss.xml'} />
  </head>
  <body class="bg-paper font-sans text-[#1a1a1a] antialiased dark:bg-paper-dark dark:text-[#d0d6e0]" id="top">
    <a href="#main-content" class="skip-link">{t(locale, 'skip')}</a>
    <Header locale={locale} currentPath={currentPath} translationExists={translationExists} />
    <main id="main-content" tabindex="-1" class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
