---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedPosts, entryUrl, isoDate, postMinutes } from '../lib/posts';
import { t } from '../i18n/index';

const posts = await publishedPosts('en-IN');
const latest = await Promise.all(posts.slice(0, 3).map(async (post) => ({ post, minutes: await postMinutes(post) })));
---
<BaseLayout
  title="Page not found — Dus AI Tool"
  description="This page does not exist."
  locale="en-IN"
  canonical="https://dusaitool.pages.dev/404/"
  currentPath="/404/"
>
  <h1 class="font-display text-4xl">Page not found (404)</h1>
  <p class="mt-3 max-w-[65ch] text-lg text-stone-600 dark:text-stone-300">This page does not exist. Try the <a href="/" class="font-medium text-brand underline dark:text-brand-dark">home page</a> or the <a href="/blog/" class="font-medium text-brand underline dark:text-brand-dark">blog</a>.</p>
  <p class="mt-3 max-w-[65ch]" lang="hi">यह पेज मौजूद नहीं है। <a href="/hi/" class="font-medium text-brand underline dark:text-brand-dark">होम पेज</a> या <a href="/hi/blog/" class="font-medium text-brand underline dark:text-brand-dark">हिंदी ब्लॉग</a> देखें।</p>

  {latest.length > 0 && (
    <section class="mt-10">
      <h2 class="text-2xl">{t('en-IN', 'suggested')}</h2>
      <ul class="mt-4 space-y-2">
        {latest.map(({ post, minutes }) => (
          <li>
            <a href={entryUrl(post)} class="flex min-h-[44px] items-center gap-3 font-medium text-brand underline dark:text-brand-dark">
              {post.data.title}
              <span class="text-sm font-normal text-stone-500 no-underline dark:text-stone-400"><time datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time> · {minutes} {t('en-IN', 'readTime')}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6"><a href="/" class="inline-flex min-h-[44px] items-center rounded-full bg-brand px-5 text-[15px] text-white dark:bg-brand-dark dark:text-[#1a1714]">{t('en-IN', 'goHome')}</a></p>
    </section>
  )}
</BaseLayout>
