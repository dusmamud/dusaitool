---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { publishedPosts, entryUrl, isoDate, postMinutes, tagUrl, tagCounts } from '../lib/posts';
import { t } from '../i18n/index';

const locale = 'en-IN' as const;
const posts = await publishedPosts(locale);
const rows = await Promise.all(posts.map(async (post) => ({ post, minutes: await postMinutes(post) })));
const [featured, ...rest] = rows;
const tags = await tagCounts(locale);
const site = Astro.site?.toString() ?? 'https://dusaitool.pages.dev/';
const blogUrl = '/blog/';
const searchUrl = '/search/';
---
<BaseLayout
  title="Dus AI Tool — AI tools tested in India"
  description="AI tools, tested in India — free or paid, in rupees, with Hindi support. English (India) edition."
  locale={locale}
  canonical={site}
  currentPath="/"
>
  <!-- Hero (afd-design-direction §5): fits the first viewport, one
       headline (max 2 lines), one sentence, two CTAs, and a real
       visual — the featured test, not an empty illustration. -->
  <section class="grid gap-8 lg:grid-cols-[1.6fr_1fr] lg:items-start">
    <div>
      <p class="hero-in inline-flex min-h-[32px] items-center gap-2 rounded-full border border-brand bg-brand-soft px-3 text-sm font-medium text-brand dark:border-brand-dark-soft dark:bg-brand-dark-soft dark:text-brand-dark">
        <span aria-hidden="true" class="size-2 rounded-full bg-brand dark:bg-brand-dark"></span>
        {t(locale, 'testedThisWeek')} · {posts.length} {t(locale, 'toolsTested')}
      </p>
      <h1 class="hero-in hero-in-1 mt-4 font-display text-4xl leading-[1.05] sm:text-5xl">AI tools, tested in India, before you pay.</h1>
      <p class="hero-in hero-in-2 mt-4 max-w-[65ch] text-lg leading-relaxed text-stone-600 dark:text-stone-300">{t(locale, 'tagline')}</p>
      <p class="hero-in hero-in-3 mt-6 flex flex-wrap gap-3">
        <a href={blogUrl} class="flex min-h-[44px] items-center rounded-full bg-brand px-5 text-[15px] text-white transition-transform duration-150 hover:-translate-y-0.5 dark:bg-brand-dark dark:text-[#1a1714]">{t(locale, 'browseTools')}</a>
        <a href={searchUrl} class="flex min-h-[44px] items-center rounded-full border border-stone-300 px-5 text-[15px] font-medium dark:border-stone-700">{t(locale, 'searchTools')}</a>
      </p>
    </div>

    {featured && (
      <aside aria-label={t(locale, 'testedThisWeek')} class="hero-in hero-in-2 rounded-2xl border border-stone-200 bg-white p-5 shadow-[0_1px_2px_rgba(0,0,0,0.06)] dark:border-stone-800 dark:bg-surface-dark">
        <p class="text-sm font-medium text-stone-500 dark:text-stone-400">{t(locale, 'testedThisWeek')}</p>
        <h2 class="mt-2 font-display text-2xl leading-snug">
          <a href={entryUrl(featured.post)} class="hover:text-brand hover:underline dark:hover:text-brand-dark">{featured.post.data.title}</a>
        </h2>
        <p class="mt-2 text-[15px] leading-relaxed text-stone-600 dark:text-stone-300">{featured.post.data.description}</p>
        {featured.post.data.verdict && (
          <p class="mt-3 rounded-lg bg-brand-soft px-3 py-2 text-sm leading-relaxed text-brand dark:bg-brand-dark-soft dark:text-brand-dark"><strong>Verdict:</strong> {featured.post.data.verdict}</p>
        )}
        <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">
          <time datetime={isoDate(featured.post.data.pubDate)}>{isoDate(featured.post.data.pubDate)}</time> · {featured.minutes} {t(locale, 'readTime')}
        </p>
      </aside>
    )}
  </section>

  {tags.length > 0 && (
    <section aria-label={t(locale, 'tags')} class="mt-10">
      <h2 class="sr-only">{t(locale, 'tags')}</h2>
      <ul class="flex flex-wrap gap-2">
        {tags.map(({ tag, count }) => (
          <li><a href={tagUrl(locale, tag)} class="flex min-h-[44px] items-center rounded-full border border-stone-300 px-4 text-sm dark:border-stone-700">{tag} ({count})</a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-12">
    <h2 class="font-display text-3xl">{t(locale, 'latest')}</h2>
    {rows.length === 0 ? (
      <p class="mt-4">{t(locale, 'noPosts')}</p>
    ) : (
      <div class="mt-6 border-t border-stone-200 dark:border-stone-800">
        {(rest.length > 0 ? rest : rows).map(({ post, minutes }) => (
          <PostRow
            href={entryUrl(post)}
            title={post.data.title}
            description={post.data.description}
            date={isoDate(post.data.pubDate)}
            minutes={minutes}
            locale={locale}
            verdict={post.data.verdict}
            tags={post.data.tags}
            tagHref={(tag) => tagUrl(locale, tag)}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
