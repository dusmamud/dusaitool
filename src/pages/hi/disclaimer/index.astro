---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const locale = 'hi' as const;
const site = (Astro.site?.toString() ?? 'https://dusaitool.pages.dev/').replace(/\/$/, '');
---
<BaseLayout
  title="अस्वीकरण — Dus AI Tool"
  description="Dus AI Tool का अस्वीकरण: टेस्ट के नतीजे एक समय के हैं, कीमतें और फ्री लिमिट बदलती रहती हैं, और AI टूल गलतियां कर सकते हैं, इसलिए भुगतान से पहले आधिकारिक पेज देखें।"
  locale={locale}
  canonical={`${site}/hi/disclaimer/`}
  currentPath="/hi/disclaimer/"
  translationExists={true}
>
  <div class="max-w-[70ch]">
    <h1 class="text-4xl">अस्वीकरण</h1>
    <p class="mt-3 text-sm text-stone-500 dark:text-text-dark-3">अंतिम अपडेट: 3 नवंबर 2026</p>
    <article class="prose prose-stone mt-6 min-w-0 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-brand dark:prose-a:text-brand-dark">
      <p>Dus AI Tool पर दी गई जानकारी सिर्फ सामान्य जानकारी के लिए है। यह हाथ से की गई टेस्टिंग पर आधारित है, लेकिन टेस्टिंग की भी सीमाएं होती हैं, और यह पेज उन सीमाओं को ईमानदारी से बताता है ताकि आप साइट का सही उपयोग कर सकें।</p>

      <h2>एक समय पर टेस्ट किया गया</h2>
      <p>हर लेख बताता है कि टेस्ट के समय कोई टूल कैसे काम करता था: सामान्य भारतीय मोबाइल कनेक्शन पर, जहां साइनअप ज़रूरी था वहां भारतीय साइनअप के साथ, किसी असली काम के लिए, सिर्फ उसके लैंडिंग पेज से नहीं। आपका नतीजा अलग हो सकता है, क्योंकि आपका अकाउंट, आपका डिवाइस, आपकी जगह, आपका प्लान, या टेस्ट के बाद टूल बनाने वाली कंपनी द्वारा किया गया बदलाव अलग हो सकता है।</p>

      <h2>कीमतें और फ्री लिमिट बदलती रहती हैं</h2>
      <p>कीमतें, फ्री लिमिट और फीचर अक्सर बदलते हैं, और कभी-कभी बिना सूचना के। किसी लेख में फ्री बताए गए टूल में बाद में कोई लिमिट जुड़ सकती है, उसका फ्री प्लान बदल सकता है, या वह चार्ज करना शुरू कर सकता है। किसी भी टूल के लिए भुगतान करने से पहले, उसका आधिकारिक प्राइसिंग पेज देखें। आपको वास्तव में क्या चार्ज किया जाएगा, इसके लिए आधिकारिक पेज ही सही स्रोत है, यह साइट नहीं।</p>

      <h2>AI टूल गलतियां कर सकते हैं</h2>
      <p>AI टूल ऐसे तथ्य, आंकड़े, उद्धरण और अनुवाद बना सकते हैं जो आत्मविश्वास से भरे लगते हैं लेकिन गलत होते हैं। इस साइट के लेख जहां ज़रूरी होता है वहां इस बारे में चेतावनी देते हैं, और यही चेतावनी उन टूल पर भी लागू होती है। महत्वपूर्ण काम के लिए — पढ़ाई, नौकरी के आवेदन, क्लाइंट का काम, पैसा, स्वास्थ्य या कानूनी मामले — हर महत्वपूर्ण तथ्य को खुद किसी भरोसेमंद स्रोत और किसी योग्य व्यक्ति से जांचें। AI के आउटपुट को बिना जांचे अपना अंतिम काम बनाकर जमा न करें।</p>

      <h2>इस तारीख तक कोई एफिलिएट या प्रायोजित सामग्री नहीं</h2>
      <p>ऊपर दी गई अंतिम अपडेट की तारीख तक, इस साइट के लेखों में कोई एफिलिएट लिंक नहीं है और वे प्रायोजित पोस्ट नहीं हैं। किसी टूल का ज़िक्र इसलिए किया जाता है क्योंकि उसे टेस्ट किया गया था, इसलिए नहीं कि किसी ने उसके लिए भुगतान किया था। अगर यह कभी बदलेगा, तो यह पेज अपडेट किया जाएगा, और कोई भी प्रायोजित सामग्री या एफिलिएट लिंक लेख में ही साफ तौर पर चिह्नित किया जाएगा।</p>

      <h2>तीसरे पक्ष के टूल</h2>
      <p>यह साइट जिन टूल के बारे में लिखती है, उन्हें नियंत्रित नहीं करती। उनकी उपलब्धता, गुणवत्ता, गोपनीयता प्रथाएं और शर्तें बिना सूचना के बदल सकती हैं, और यह साइट उनके लिए ज़िम्मेदार नहीं है। जब आप किसी तीसरे पक्ष के टूल पर साइन अप करते हैं, तो आप उस टूल की अपनी शर्तें और गोपनीयता नीति स्वीकार करते हैं।</p>

      <h2>पेशेवर सलाह नहीं है</h2>
      <p>इस साइट पर कुछ भी आपकी किसी खास स्थिति के लिए पेशेवर सलाह नहीं है। पढ़ाई, करियर, व्यापार या पैसे के बारे में लेख सिर्फ सामान्य मार्गदर्शन हैं। किसी महत्वपूर्ण फैसले के लिए, किसी योग्य व्यक्ति से सलाह लें जो आपकी स्थिति को जानता हो।</p>

      <h2>दायित्व</h2>
      <p>आप इस साइट की जानकारी का उपयोग अपने विवेक से करते हैं। कानून की अनुमति की सीमा तक, Dus AI Tool किसी टूल के बदलने, किसी फ्री लिमिट के खत्म होने, किसी AI गलती को बिना जांचे छोड़ने, या किसी लेख को पढ़कर लिए गए फैसले से हुए नुकसान के लिए ज़िम्मेदार नहीं है। अगर कोई टूल आपके लिए लेख में बताए तरीके से काम नहीं करता, तो व्यावहारिक अगला कदम टूल के आधिकारिक पेज और उसके सपोर्ट को देखना है, न कि लेख को वादा मानना।</p>

      <h2>संपर्क</h2>
      <p>इस अस्वीकरण के बारे में किसी सामान्य प्रश्न के लिए, आप साइट के मालिक तक Dus AI Tool के ज़रिए, dusaitool.pages.dev पर पहुंच सकते हैं।</p>
    </article>
  </div>
</BaseLayout>
