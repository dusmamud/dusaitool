---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tagCounts } from '../../../lib/posts';
import { t } from '../../../i18n/index';

const locale = 'hi' as const;
const site = (Astro.site?.toString() ?? 'https://dusaitool.pages.dev/').replace(/\/$/, '');
const tags = await tagCounts(locale);
const popular = tags.slice(0, 5).map((x) => x.tag);
const searchingText = t(locale, 'searching');
---
<BaseLayout
  title="खोजें — Dus AI Tool"
  description="टेस्ट किए गए AI टूल, ट्यूटोरियल और तुलना खोजें।"
  locale={locale}
  canonical={`${site}/hi/search/`}
  currentPath="/hi/search/"
>
  <h1 class="text-4xl">{t(locale, 'search')}</h1>
  <form role="search" class="mt-6" onsubmit="return false;">
    <label for="search-input" class="sr-only">{t(locale, 'search')}</label>
    <input
      id="search-input"
      name="q"
      type="search"
      placeholder={t(locale, 'searchPlaceholder')}
      autocomplete="off"
      class="h-12 w-full rounded-lg border border-stone-300 bg-white px-4 text-[16px] dark:border-border-dark-2 dark:bg-surface-dark"
    />
  </form>
  <p class="mt-3 text-sm text-stone-500 dark:text-text-dark-3">{t(locale, 'searchHint')}</p>

  {popular.length > 0 && (
    <section aria-label={t(locale, 'popularSearches')} class="mt-6">
      <h2 class="text-sm">{t(locale, 'popularSearches')}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {popular.map((tag) => (
          <li><button type="button" data-search-term={tag} class="search-term flex min-h-[44px] items-center rounded-md border border-stone-300 px-4 text-sm dark:border-border-dark-2">{tag}</button></li>
        ))}
      </ul>
    </section>
  )}

  <div id="search-results" class="mt-6 flex flex-col gap-4" aria-live="polite"></div>
  <p id="search-status" class="mt-4 text-sm text-stone-500"></p>
  <p id="search-empty" class="mt-4 hidden text-sm text-stone-600 dark:text-text-dark-3">{t(locale, 'searchNoResults')}</p>

  <script define:vars={{ noIndexText: 'खोज इंडेक्स अभी बना नहीं है। पहले npm run build चलाएं।', searchingText }}>
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');
    const statusEl = document.getElementById('search-status');
    const emptyEl = document.getElementById('search-empty');
    let pagefind = null;
    let timer = null;

    async function init() {
      try {
        pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        await pagefind.init();
      } catch {
        if (statusEl) statusEl.textContent = noIndexText;
      }
    }

    async function run(query) {
      if (!pagefind || !resultsEl) return;
      const search = await pagefind.search(query);
      const all = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      // Hindi page shows only Hindi results (URLs starting with /hi/).
      const items = all.filter((item) => item.url.startsWith('/hi/')).slice(0, 10);
      if (statusEl) statusEl.textContent = `${items.length} ${items.length === 1 ? 'परिणाम' : 'परिणाम'}`;
      if (emptyEl) emptyEl.classList.toggle('hidden', items.length > 0);
      // afd-static-sites §7 / ui-review §4: never innerHTML a string.
      // Titles and excerpts come from the build index, but they are
      // still inserted as text, not HTML, so a title containing '<'
      // or '&' can never break out of the page. Same classes, same
      // layout, only the insertion method changes.
      resultsEl.replaceChildren();
      items.forEach((item) => {
        const article = document.createElement('article');
        article.className = 'rounded-xl border border-stone-200 bg-white p-4 dark:border-border-dark dark:bg-surface-dark';
        const h2 = document.createElement('h2');
        const link = document.createElement('a');
        link.href = item.url;
        link.className = 'text-brand underline dark:text-brand-dark';
        link.textContent = item.meta?.title ?? item.url;
        h2.appendChild(link);
        const p = document.createElement('p');
        p.className = 'mt-1 text-sm text-stone-600 dark:text-text-dark-3';
        p.textContent = item.excerpt ?? '';
        article.append(h2, p);
        resultsEl.appendChild(article);
      });
    }

    function trigger(query) {
      if (input) input.value = query;
      clearTimeout(timer);
      if (query.trim().length < 2) {
        if (resultsEl) resultsEl.replaceChildren();
        if (emptyEl) emptyEl.classList.add('hidden');
        if (statusEl) statusEl.textContent = '';
        return;
      }
      if (statusEl) statusEl.textContent = searchingText;
      timer = setTimeout(() => run(query.trim()), 200);
    }

    input?.addEventListener('input', (event) => trigger(event.target.value));
    document.querySelectorAll('.search-term').forEach((btn) => {
      btn.addEventListener('click', () => trigger(btn.dataset.searchTerm ?? ''));
    });

    init();
  </script>
</BaseLayout>
