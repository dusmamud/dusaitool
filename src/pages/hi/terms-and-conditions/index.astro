---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const locale = 'hi' as const;
const site = (Astro.site?.toString() ?? 'https://dusaitool.pages.dev/').replace(/\/$/, '');
---
<BaseLayout
  title="नियम और शर्तें — Dus AI Tool"
  description="Dus AI Tool के उपयोग की नियम और शर्तें: यह टेस्ट किए गए AI टूल का ब्लॉग किस काम का है, इसकी सामग्री का उपयोग कैसे किया जा सकता है, और यह क्या वादा नहीं करता।"
  locale={locale}
  canonical={`${site}/hi/terms-and-conditions/`}
  currentPath="/hi/terms-and-conditions/"
  translationExists={true}
>
  <div class="max-w-[70ch]">
    <h1 class="text-4xl">नियम और शर्तें</h1>
    <p class="mt-3 text-sm text-stone-500 dark:text-text-dark-3">अंतिम अपडेट: 3 नवंबर 2026</p>
    <article class="prose prose-stone mt-6 min-w-0 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-brand dark:prose-a:text-brand-dark">
      <p>ये शर्तें dusaitool.pages.dev पर Dus AI Tool के उपयोग पर लागू होती हैं। इस साइट का उपयोग करके, आप इन शर्तों को स्वीकार करते हैं। अगर आप सहमत नहीं हैं, तो कृपया साइट का उपयोग न करें।</p>

      <h2>यह साइट क्या है</h2>
      <p>Dus AI Tool एक ब्लॉग है जो भारत में AI टूल को टेस्ट करता है और उनके बारे में गाइड लिखता है: हर टूल क्या करता है, उसकी फ्री लिमिट क्या है, भारत में उसकी कीमत क्या है, और वह किसके लिए सही है। यह सामग्री सामान्य जानकारी है, जो आपको टूल चुनने में मदद करने के लिए लिखी जाती है। यह कोई सेवा, अकाउंट या मार्केटप्लेस नहीं है, और यह टूल नहीं बेचता।</p>

      <h2>पेशेवर सलाह नहीं है</h2>
      <p>इस साइट पर कुछ भी आपकी किसी खास स्थिति के लिए पेशेवर सलाह नहीं है — न कानूनी, न चिकित्सा, न वित्तीय, न शैक्षणिक, न करियर सलाह। पढ़ाई, काम या व्यापार के टूल के बारे में लेख सिर्फ सामान्य मार्गदर्शन हैं। किसी महत्वपूर्ण फैसले के लिए, काम करने से पहले किसी योग्य व्यक्ति से और टूल के अपने आधिकारिक दस्तावेज़ से जांच लें।</p>

      <h2>सटीकता और बदलाव</h2>
      <p>टूल तेज़ी से बदलते हैं। किसी लेख में बताई गई कीमतें, फ्री लिमिट और फीचर उस समय सही थे जब वह लेख टेस्ट किया गया था, और तब से वे बदल सकते हैं। किसी भी टूल के लिए भुगतान करने से पहले, उसका आधिकारिक प्राइसिंग पेज देखें। अगर आपको लगे कि कोई लेख पुराना हो गया है, तो आधिकारिक पेज को सही स्रोत मानें।</p>

      <h2>बौद्धिक संपदा</h2>
      <p>इस साइट के लेख, पाठ और डिज़ाइन Dus AI Tool के हैं, जब तक किसी हिस्से को साफ तौर पर किसी और का नहीं बताया गया हो। आप किसी लेख का लिंक साझा कर सकते हैं, और Dus AI Tool को श्रेय देकर उसका छोटा हिस्सा उद्धृत कर सकते हैं। बिना अनुमति के आप किसी पूरे लेख को, या उसके बड़े हिस्से को, किसी और वेबसाइट या किसी और उत्पाद में दोबारा प्रकाशित नहीं कर सकते।</p>

      <h2>तीसरे पक्ष के टूल और वेबसाइटें</h2>
      <p>लेख तीसरे पक्ष के टूल का नाम लेते हैं और बताते हैं कि टेस्टिंग में वे कैसे काम करते थे। वे टूल दूसरी कंपनियों द्वारा बनाए और चलाए जाते हैं। जब आप उनका उपयोग करते हैं, तो उनकी अपनी शर्तें, गोपनीयता नीतियां और कीमतें लागू होती हैं, और यह साइट उन्हें नियंत्रित नहीं करती। इस साइट पर किसी टूल का ज़िक्र इस बात की गारंटी नहीं है कि वह टूल आपके लिए उसी तरह काम करेगा, या वह फ्री या उपलब्ध बना रहेगा।</p>

      <h2>स्वीकार्य उपयोग</h2>
      <p>इस साइट का उपयोग कानूनी तरीके से करें। साइट को बाधित करने, उस पर ज़्यादा भार डालने, या उसके उन हिस्सों तक पहुंचने की कोशिश न करें जो सार्वजनिक होने के लिए नहीं हैं। साइट की सामग्री को बड़ी मात्रा में कॉपी करके कहीं और दोबारा प्रकाशित न करें।</p>

      <h2>उपलब्धता और दायित्व</h2>
      <p>यह साइट जैसी है, वैसी ही दी जाती है, बिना इस गारंटी के कि वह हमेशा उपलब्ध रहेगी या उसमें कोई गलती नहीं होगी। कानून की अनुमति की सीमा तक, Dus AI Tool किसी लेख पर भरोसा करने, किसी तीसरे पक्ष के टूल के बदलने या बंद होने, या इस साइट को पढ़कर लिए गए किसी फैसले से हुए नुकसान के लिए ज़िम्मेदार नहीं है। Disclaimer पेज पर दिया गया पूरा अस्वीकरण इन शर्तों का हिस्सा है।</p>

      <h2>इन शर्तों में बदलाव</h2>
      <p>अगर साइट बदलेगी, तो ये शर्तें भी बदल सकती हैं। कोई भी बदलाव इस पेज पर नई अंतिम अपडेट की तारीख के साथ दिखाया जाएगा। बदलाव के बाद साइट का उपयोग जारी रखने का मतलब है कि आप अपडेट की गई शर्तों को स्वीकार करते हैं।</p>

      <h2>लागू कानून</h2>
      <p>ये शर्तें भारत के कानूनों के तहत शासित होती हैं, क्योंकि यह साइट भारत के पाठकों के लिए लिखी जाती है। इन शर्तों के बारे में कोई भी विवाद उन्हीं कानूनों के तहत निपटाया जाएगा।</p>

      <h2>संपर्क</h2>
      <p>इन शर्तों के बारे में किसी सामान्य प्रश्न के लिए, आप साइट के मालिक तक Dus AI Tool के ज़रिए, dusaitool.pages.dev पर पहुंच सकते हैं।</p>
    </article>
  </div>
</BaseLayout>
