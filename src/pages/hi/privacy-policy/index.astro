---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const locale = 'hi' as const;
const site = (Astro.site?.toString() ?? 'https://dusaitool.pages.dev/').replace(/\/$/, '');
---
<BaseLayout
  title="गोपनीयता नीति — Dus AI Tool"
  description="Dus AI Tool की गोपनीयता नीति: यह स्टैटिक ब्लॉग क्या इकट्ठा करता है, क्या नहीं करता, और खोज व थीम आपकी ब्राउज़र में कैसे काम करती हैं।"
  locale={locale}
  canonical={`${site}/hi/privacy-policy/`}
  currentPath="/hi/privacy-policy/"
  translationExists={true}
>
  <div class="max-w-[70ch]">
    <h1 class="text-4xl">गोपनीयता नीति</h1>
    <p class="mt-3 text-sm text-stone-500 dark:text-text-dark-3">अंतिम अपडेट: 3 नवंबर 2026</p>
    <article class="prose prose-stone mt-6 min-w-0 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-brand dark:prose-a:text-brand-dark">
      <p>Dus AI Tool भारत में टेस्ट किए गए AI टूल के बारे में एक स्टैटिक ब्लॉग है। इस साइट पर कोई अकाउंट, कोई लॉगिन, कोई साइनअप फॉर्म और कोई संपर्क फॉर्म नहीं है। यह नीति सरल भाषा में बताती है कि यह साइट क्या इकट्ठा करती है और क्या नहीं करती।</p>

      <h2>जो जानकारी हम इकट्ठा नहीं करते</h2>
      <p>हम आपका नाम, ईमेल पता, फोन नंबर या कोई और व्यक्तिगत जानकारी सीधे इकट्ठा नहीं करते, क्योंकि साइट आपसे यह कभी मांगती ही नहीं। इस साइट पर कोई न्यूज़लेटर साइनअप, कोई कमेंट सिस्टम और कोई यूज़र अकाउंट नहीं है।</p>

      <h2>जो जानकारी सिर्फ आपकी ब्राउज़र में रहती है</h2>
      <p>दो चीज़ें पूरी तरह आपकी अपनी ब्राउज़र में काम करती हैं और हमें कभी भेजी नहीं जातीं:</p>
      <ul>
        <li><strong>थीम की पसंद।</strong> जब आप लाइट और डार्क मोड के बीच बदलते हैं, तो वह पसंद आपकी ब्राउज़र की लोकल स्टोरेज में सहेजी जाती है ताकि अगली बार साइट उसे याद रखे। यह किसी सर्वर को नहीं भेजी जाती।</li>
        <li><strong>खोज।</strong> इस साइट पर खोज आपकी ब्राउज़र में चलती है, एक खोज इंडेक्स के ज़रिए जो साइट प्रकाशित होते समय बनता है। आपके खोजे गए शब्द आपकी ब्राउज़र से बाहर नहीं जाते, और हम कोई खोज इतिहास नहीं रखते।</li>
      </ul>

      <h2>होस्टिंग</h2>
      <p>यह साइट Cloudflare Pages पर होस्ट की जाती है। साइट को होस्ट करने और सुरक्षित रखने के हिस्से के रूप में, Cloudflare सामान्य सर्वर लॉग रख सकता है, जैसे मांगे गए पेज और अनुरोध के बारे में सामान्य तकनीकी जानकारी। हमें उन लॉग से कोई व्यक्तिगत डेटा नहीं मिलता, हम उसका उपयोग नहीं करते और उसे बेचते नहीं, और हम उसे किसी और चीज़ से जोड़ते नहीं, क्योंकि जोड़ने के लिए कोई और चीज़ है ही नहीं।</p>

      <h2>कुकीज़</h2>
      <p>यह साइट खुद कोई कुकी नहीं लगाती। अगर आप किसी लेख से किसी तीसरे पक्ष के टूल की अपनी वेबसाइट पर जाते हैं, तो वह वेबसाइट अपनी गोपनीयता नीति के तहत अपनी कुकीज़ लगा सकती है। हम उन कुकीज़ को नियंत्रित नहीं करते।</p>

      <h2>एनालिटिक्स और विज्ञापन</h2>
      <p>ऊपर दी गई अंतिम अपडेट की तारीख तक, यह साइट किसी एनालिटिक्स सेवा, किसी विज्ञापन नेटवर्क और किसी ट्रैकिंग पिक्सल का उपयोग नहीं करती। अगर यह कभी बदलेगा, तो पहले यह नीति अपडेट की जाएगी, और इस पेज के ऊपर दी गई अपडेट की तारीख बदल जाएगी।</p>

      <h2>लेखों में बताए गए तीसरे पक्ष के टूल</h2>
      <p>इस साइट के लेख तीसरे पक्ष के AI टूल का नाम लेते हैं और उनका वर्णन करते हैं। उन टूल की अपनी गोपनीयता नीतियां और शर्तें होती हैं, जो तब लागू होती हैं जब आप उन पर साइन अप करते हैं या उनका उपयोग करते हैं। इस साइट पर लेख पढ़ने से उन टूल के साथ आपका कोई अकाउंट नहीं बनता, और यह साइट आपकी कोई जानकारी उन्हें नहीं देती।</p>

      <h2>बच्चों की गोपनीयता</h2>
      <p>यह साइट सामान्य पाठकों के लिए लिखी जाती है और बच्चों के लिए विशेष रूप से नहीं है। चूंकि साइट किसी की भी व्यक्तिगत जानकारी इकट्ठा नहीं करती, इसलिए वह बच्चों की भी कोई व्यक्तिगत जानकारी इकट्ठा नहीं करती।</p>

      <h2>इस नीति में बदलाव</h2>
      <p>अगर साइट बदलेगी, जैसे भविष्य में कोई संपर्क फॉर्म या एनालिटिक्स सेवा जुड़ेगी, तो यह नीति भी बदल सकती है। कोई भी बदलाव इस पेज पर नई अंतिम अपडेट की तारीख के साथ दिखाया जाएगा। बदलाव के बाद साइट का उपयोग जारी रखने का मतलब है कि आप अपडेट की गई नीति को स्वीकार करते हैं।</p>

      <h2>संपर्क</h2>
      <p>चूंकि यह साइट कोई व्यक्तिगत जानकारी इकट्ठा नहीं करती, इसलिए देखने, ठीक करने या हटाने के लिए कोई व्यक्तिगत डेटा है ही नहीं। इस नीति के बारे में किसी सामान्य प्रश्न के लिए, आप साइट के मालिक तक Dus AI Tool के ज़रिए, dusaitool.pages.dev पर पहुंच सकते हैं।</p>
    </article>
  </div>
</BaseLayout>
