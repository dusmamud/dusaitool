---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostRow from '../../../../components/PostRow.astro';
import { publishedPosts, entryUrl, isoDate, postMinutes, tagCounts, tagUrl } from '../../../../lib/posts';
import { t } from '../../../../i18n/index';

export async function getStaticPaths() {
  const tags = await tagCounts('hi');
  return tags.map(({ tag }) => ({ params: { tag: tagUrl('hi', tag).split('/').filter(Boolean).pop()! }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await publishedPosts('hi')).filter((p) => (p.data.tags ?? []).includes(tag));
const rows = await Promise.all(posts.map(async (post) => ({ post, minutes: await postMinutes(post) })));
const site = (Astro.site?.toString() ?? 'https://dusaitool.pages.dev/').replace(/\/$/, '');
---
<BaseLayout
  title={`${tag} — ब्लॉग — Dus AI Tool`}
  description={`टैग ${tag} वाले टेस्ट किए गए AI टूल गाइड।`}
  locale="hi"
  canonical={`${site}/hi/blog/tag/${Astro.params.tag}/`}
  currentPath={`/hi/blog/tag/${Astro.params.tag}/`}
>
  <h1 class="text-4xl">{tag}</h1>
  <p class="mt-3 text-lg text-stone-600 dark:text-[#8a8f98]">{posts.length} पोस्ट</p>
  <p class="mt-2"><a href="/hi/blog/" class="flex min-h-[44px] items-center font-medium text-brand underline dark:text-brand-dark">← {t('hi', 'backToBlog')}</a></p>
  <div class="mt-8 border-t border-stone-200 dark:border-[#23252a]">
    {rows.map(({ post, minutes }) => (
      <PostRow href={entryUrl(post)} title={post.data.title} description={post.data.description} date={isoDate(post.data.pubDate)} minutes={minutes} locale="hi" verdict={post.data.verdict} tags={post.data.tags} tagHref={(t2) => tagUrl('hi', t2)} />
    ))}
  </div>
  {rows.length === 0 && <p class="mt-6">{t('hi', 'noPosts')}</p>}
</BaseLayout>
