---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleToc from '../../../components/ArticleToc.astro';
import PostRow from '../../../components/PostRow.astro';
import { publishedPosts, entrySlug, entryUrl, isoDate, postMinutes, hasTranslation, relatedPosts, tagUrl } from '../../../lib/posts';
import { t } from '../../../i18n/index';

export async function getStaticPaths() {
  const posts = await publishedPosts('hi');
  return posts.map((post) => ({ params: { slug: entrySlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = await postMinutes(post);
const site = (Astro.site?.toString() ?? 'https://dusaitool.pages.dev/').replace(/\/$/, '');
const canonical = `${site}/hi/blog/${entrySlug(post)}/`;
const translationExists = await hasTranslation(entrySlug(post), 'en-IN');
const updated = post.data.updatedDate ?? post.data.pubDate;
const toc = headings.filter((h) => h.depth === 2);
const related = await relatedPosts(post, 3);
const relatedRows = await Promise.all(related.map(async (p) => ({ post: p, minutes: await postMinutes(p) })));
---
<BaseLayout
  title={`${post.data.title} — Dus AI Tool`}
  description={post.data.description}
  locale="hi"
  canonical={canonical}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  updatedTime={updated.toISOString()}
  currentPath={`/hi/blog/${entrySlug(post)}/`}
  translationExists={translationExists}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <nav aria-label="ब्रेडक्रंब" class="text-sm text-stone-500 dark:text-[#8a8f98]">
    <ol class="flex min-w-0 flex-wrap items-center gap-2">
      <li><a href="/hi/" class="flex min-h-[44px] items-center font-medium text-brand underline dark:text-brand-dark">{t('hi', 'home')}</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/hi/blog/" class="flex min-h-[44px] items-center font-medium text-brand underline dark:text-brand-dark">{t('hi', 'blog')}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="min-w-0 max-w-full truncate">{post.data.title}</li>
    </ol>
  </nav>

  <div class="mx-auto mt-6 grid min-w-0 max-w-[1044px] grid-cols-1 gap-8 lg:grid-cols-[minmax(0,680px)_300px] lg:gap-16">
    <article class="prose prose-stone min-w-0 max-w-none dark:prose-invert prose-a:text-brand dark:prose-a:text-brand-dark">
      <h1>{post.data.title}</h1>
      <p class="not-prose text-sm text-stone-500 dark:text-[#8a8f98]">
        {t('hi', 'published')} <time datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time>
        {', '}{t('hi', 'updated')} <time datetime={isoDate(updated)}>{isoDate(updated)}</time>
        {', '}{minutes} {t('hi', 'readTime')}
      </p>
      {toc.length > 0 && <ArticleToc toc={toc} label={t('hi', 'contents')} />}
      <Content />
    </article>
      <aside aria-label={t('hi', 'contents')} class="hidden min-w-0 lg:sticky lg:top-20 lg:block lg:self-start lg:max-h-[calc(100vh-5rem)] lg:overflow-y-auto lg:pb-4">
        <div class="space-y-10">
          {toc.length > 0 && (
            <nav>
              <h2 class="text-sm text-[#1a1a1a] dark:text-[#f7f8f8]">{t('hi', 'contents')}</h2>
              <ul class="mt-3 space-y-1 border-l border-stone-200 dark:border-[#23252a]">
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`} class="flex min-h-[36px] items-center border-l-2 border-transparent ps-3 text-sm text-stone-600 hover:border-brand hover:text-brand dark:text-[#8a8f98] dark:hover:text-brand-dark">{h.text}</a></li>
                ))}
              </ul>
            </nav>
          )}
          {relatedRows.length > 0 && (
            <section>
              <h2 class="text-sm text-[#1a1a1a] dark:text-[#f7f8f8]">{t('hi', 'related')}</h2>
              <ul class="mt-3 space-y-1 border-l border-stone-200 dark:border-[#23252a]">
                {relatedRows.map(({ post: p }) => (
                  <li><a href={entryUrl(p)} class="flex min-h-[44px] items-center border-l-2 border-transparent ps-3 text-sm text-stone-600 hover:border-brand hover:text-brand dark:text-[#8a8f98] dark:hover:text-brand-dark">{p.data.title}</a></li>
                ))}
              </ul>
            </section>
          )}
          <section>
            <h2 class="text-sm text-[#1a1a1a] dark:text-[#f7f8f8]">{t('hi', 'tags')}</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {(post.data.tags ?? []).map((tag) => (
                <li><a href={tagUrl('hi', tag)} class="flex min-h-[36px] items-center rounded-full border border-stone-200 px-3 text-sm text-stone-600 hover:border-brand hover:text-brand dark:border-[#23252a] dark:text-[#8a8f98] dark:hover:text-brand-dark">{tag}</a></li>
              ))}
            </ul>
            <p class="mt-5 text-sm leading-relaxed text-stone-500 dark:text-[#8a8f98]">{t('hi', 'footerNote')}</p>
          </section>
        </div>
      </aside>

  </div>

  <p class="mt-10"><a href="/hi/blog/" class="flex min-h-[44px] items-center font-medium text-brand underline dark:text-brand-dark">← {t('hi', 'backToBlog')}</a></p>

  {relatedRows.length > 0 && (
    <section class="mt-12">
      <h2 class="text-2xl">{t('hi', 'related')}</h2>
      <div class="mt-6 border-t border-stone-200 dark:border-[#23252a]">
        {relatedRows.map(({ post: p, minutes: m }) => (
          <PostRow href={entryUrl(p)} title={p.data.title} description={p.data.description} date={isoDate(p.data.pubDate)} minutes={m} locale="hi" verdict={p.data.verdict} />
        ))}
      </div>
    </section>
  )}

<script>
  /* Desktop TOC active section: IntersectionObserver, not scroll
     offsets. Root margin accounts for the 56px sticky header. */
  const tocHeadings = Array.from(document.querySelectorAll('article h2[id]'));
  const tocLinks = Array.from(document.querySelectorAll('aside nav a'));
  if ('IntersectionObserver' in window && tocHeadings.length > 0 && tocLinks.length > 0) {
    const byId = new Map(tocHeadings.map((h) => [h.id, tocLinks.find((a) => a.getAttribute('href') === `#${h.id}`)]));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          tocLinks.forEach((l) => l.removeAttribute('data-active'));
          byId.get(entry.target.id)?.setAttribute('data-active', 'true');
        });
      },
      { rootMargin: '-96px 0px -70% 0px' },
    );
    tocHeadings.forEach((h) => observer.observe(h));
  }
</script>
</BaseLayout>
