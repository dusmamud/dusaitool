---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts, tagCounts, tagUrl } from '../../lib/posts';
import { t } from '../../i18n/index';

const locale = 'en-IN' as const;
const site = Astro.site?.toString() ?? 'https://dusaitool.pages.dev/';
const tags = await tagCounts(locale);
const popular = tags.slice(0, 5).map((x) => x.tag);
---
<BaseLayout
  title="Search — Dus AI Tool"
  description="Search tested AI tools, tutorials and comparisons."
  locale={locale}
  canonical={`${site}search/`}
  currentPath="/search/"
>
  <h1 class="font-display text-4xl">{t(locale, 'search')}</h1>
  <form role="search" class="mt-6" onsubmit="return false;">
    <label for="search-input" class="sr-only">{t(locale, 'search')}</label>
    <input
      id="search-input"
      name="q"
      type="search"
      placeholder={t(locale, 'searchPlaceholder')}
      autocomplete="off"
      class="h-12 w-full rounded-xl border border-stone-300 bg-white px-4 text-[16px] dark:border-border-dark-2 dark:bg-surface-dark"
    />
  </form>
  <p class="mt-3 text-sm text-stone-500 dark:text-text-dark-3">{t(locale, 'searchHint')}</p>

  {popular.length > 0 && (
    <section aria-label={t(locale, 'popularSearches')} class="mt-6">
      <h2 class="text-sm">{t(locale, 'popularSearches')}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {popular.map((tag) => (
          <li><button type="button" data-search-term={tag} class="search-term flex min-h-[44px] items-center rounded-full border border-stone-300 px-4 text-sm dark:border-border-dark-2">{tag}</button></li>
        ))}
      </ul>
    </section>
  )}

  <div id="search-results" class="mt-6 space-y-4" aria-live="polite"></div>
  <p id="search-status" class="mt-4 text-sm text-stone-500"></p>
  <p id="search-empty" class="mt-4 hidden text-sm text-stone-600 dark:text-text-dark-3">{t(locale, 'searchNoResults')}</p>

  <script define:vars={{ noIndexText: 'Search index is not built yet. Run npm run build first.' }}>
    // Pagefind is generated by `npm run build` into /pagefind/.
    // In dev it does not exist yet, so fail gracefully instead of
    // showing a broken search box.
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');
    const statusEl = document.getElementById('search-status');
    const emptyEl = document.getElementById('search-empty');
    let pagefind = null;
    let timer = null;

    async function init() {
      try {
        pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        await pagefind.init();
      } catch {
        if (statusEl) statusEl.textContent = noIndexText;
      }
    }

    async function run(query) {
      if (!pagefind || !resultsEl) return;
      const search = await pagefind.search(query);
      const all = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      // English page shows only English results (URLs without /hi/).
      const items = all.filter((item) => !item.url.startsWith('/hi/')).slice(0, 10);
      if (statusEl) statusEl.textContent = `${items.length} ${items.length === 1 ? 'result' : 'results'}`;
      if (emptyEl) emptyEl.classList.toggle('hidden', items.length > 0);
      resultsEl.innerHTML = items
        .map((item) => `<article class="rounded-xl border border-stone-200 bg-white p-4 dark:border-border-dark dark:bg-surface-dark"><h2 class=""><a href="${item.url}" class="text-brand underline dark:text-brand-dark">${item.meta?.title ?? item.url}</a></h2><p class="mt-1 text-sm text-stone-600 dark:text-text-dark-3">${item.excerpt ?? ''}</p></article>`)
        .join('');
    }

    function trigger(query) {
      if (input) input.value = query;
      clearTimeout(timer);
      if (query.trim().length < 2) {
        if (resultsEl) resultsEl.innerHTML = '';
        if (emptyEl) emptyEl.classList.add('hidden');
        if (statusEl) statusEl.textContent = '';
        return;
      }
      timer = setTimeout(() => run(query.trim()), 200);
    }

    input?.addEventListener('input', (event) => trigger(event.target.value));
    document.querySelectorAll('.search-term').forEach((btn) => {
      btn.addEventListener('click', () => trigger(btn.dataset.searchTerm ?? ''));
    });

    init();
  </script>
</BaseLayout>
